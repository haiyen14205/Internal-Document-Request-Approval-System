@model InternalRequest_Management.Models.LoaiDeNghiVm
@{
    var laTao = Model.MaLoai == 0;
    ViewData["Title"] = laTao ? "Thêm loại đề nghị" : "Sửa loại đề nghị";
}
<h3>@ViewData["Title"]</h3>

<form asp-action="@(laTao ? "Create" : "Edit")" method="post" class="col-md-6">
    <input type="hidden" asp-for="MaLoai" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="TenLoai" class="form-label"></label>
        <input asp-for="TenLoai" class="form-control" />
        <span asp-validation-for="TenLoai" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaKyThuat" class="form-label"></label>
        <input asp-for="MaKyThuat" class="form-control" />
        <span asp-validation-for="MaKyThuat" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="TrangThaiSuDung" class="form-check-input" />
        <label asp-for="TrangThaiSuDung" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>